{
  "name": "dsh-usage-dashboard",
  "version": "0.1.1",
  "description": "Token usage dashboard for DeepSeek Harness (GitHub-only distribution, not published to npm): stat cards, 12-month activity heatmap, per-model daily trend and model share, with hover tooltips",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check tools/backfill.mjs"
  },
  "files": [
    "lib/**/*.js",
    "tools/**/*.mjs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "token-usage"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bzhao0110/dsh-usage-dashboard.git"
  },
  "homepage": "https://github.com/bzhao0110/dsh-usage-dashboard#readme",
  "bugs": {
    "url": "https://github.com/bzhao0110/dsh-usage-dashboard/issues"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.6 <0.2.0-0 || >=0.2.0-rc <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6 <0.2.0-0 || >=0.2.0-rc <0.3.0-0",
    "@deepseek-ai/dsh-session-projection": ">=0.1.0-rc.6 <0.2.0-0 || >=0.2.0-rc <0.3.0-0",
    "react": "^18.2.0"
  }
}
